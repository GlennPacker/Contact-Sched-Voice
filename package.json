{
  "type": "module",
  "name": "contact-sched-voice-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky install",
    "lint": "npm run lint:scss && node scripts/run-eslint.js",
    "lint:scss": "node ./tools/no-scss-comments.js",
    "lint:fix": "node scripts/run-eslint.js --fix",
    "test": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-bootstrap": "^2.10.10",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.69.0",
    "sass": "^1.97.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "npm run lint:fix",
      "git add"
    ],
    "*.{scss,css}": [
      "npm run lint:scss",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx --no-install lint-staged"
    }
  },
  "huskyDep": "0"
}
